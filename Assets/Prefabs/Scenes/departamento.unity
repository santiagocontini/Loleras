  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8784b8541df577b4ba90aea3665dac6e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NotaAleatoria
  panelNota: {fileID: 1153652005}
  textoNota: {fileID: 956969134}
  frases:
  - Si encontraste esto te quedan 100 mas
  - " Recordatorio: comprar papel higi\xE9nico. Otra vez.\n"
  - "Esta nota cumple m\xE1s funciones decorativas que informativas."
  - "Si est\xE1s leyendo esto, claramente no encontraste algo mejor para hacer."
  - "Se estima que el 73% de los goles en penales fueron acompa\xF1ados por un \"mir\xE1
    y aprend\xE9\"."
  - "Se estima que el 73% de los goles en penales fueron acompa\xF1ados por un \"mir\xE1
    y aprend\xE9\"."
  - "\u2022 Atenci\xF3n: si le\xE9s m\xE1s de 10 notas seguidas, el personaje pasa
    a ser oficialmente un desocupado."
  - "\u2022 Dicen que existe una partida donde alguien gan\xF3 todos los minijuegos.
    Nadie pudo demostrarlo.\n"
  - "\u2022 Si el armado sali\xF3 mal, la culpa es del papelillo. Siempre."
  idObjeto: 3
  iconoLlave: {fileID: 1098022863}
  interactionText: {fileID: 190244015}
